ENV=dev
PORT=3000
DB_CONNECTION_INTERVAL=2000
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change_me
DB_NAME=firewall_dev

# CloudAMQP-hosted RabbitMQ (Project 7). Placeholder values only - never
# commit a real CloudAMQP URL or credential. See README for details.
CLOUDAMQP_URL=amqps://user:password@host/vhost
RABBITMQ_EXCHANGE=firewall.commands
RABBITMQ_QUEUE=romi.firewall.commands
RABBITMQ_ROUTING_PREFIX=romi

# Used only by the DrizzleRuleRepository integration tests (tests/integration/db).
# Must point at a disposable, isolated database — TEST_DB_NAME is required to
# end with "_test" and is never allowed to be firewall_dev. Leave unset to skip
# these tests locally.
TEST_DB_HOST=localhost
TEST_DB_PORT=5432
TEST_DB_USER=postgres
TEST_DB_PASSWORD=change_me
TEST_DB_NAME=firewall_test

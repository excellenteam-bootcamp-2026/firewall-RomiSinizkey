# Docker development environment template.
#
# Copy to .env.dev and adjust if needed — .env.dev is gitignored, this file is not:
#   cp .env.dev.example .env.dev
#
# DB_HOST is the PostgreSQL Compose service name, not localhost or
# host.docker.internal — inside a Compose network, localhost resolves to the
# backend container itself, not the database container.
#
# ASSUMPTION: no Compose file exists yet (Issues #44/#45), so no Postgres
# service name has been decided in this repository. "postgres" is used below
# as a placeholder — update this file and Issue #44's docker-compose.dev.yml
# together if a different service name is chosen there.

ENV=dev
PORT=3000
DB_CONNECTION_INTERVAL=2000

DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change_me
DB_NAME=firewall_dev

# PostgreSQL container variables, read by the official postgres image itself
# (not by this Node app — env.ts has no POSTGRES_* keys). Kept equal to the
# DB_* values above so the backend and the database container are configured
# from a single source of truth, mapped explicitly in Issue #44's compose file:
#   POSTGRES_USER     = DB_USER
#   POSTGRES_PASSWORD = DB_PASSWORD
#   POSTGRES_DB       = DB_NAME
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=firewall_dev

# CloudAMQP-hosted RabbitMQ (Project 7). Placeholder values only - never
# commit a real CloudAMQP URL or credential. Read independently by the Python
# consumer's own settings (python-rule-service/.env.dev) - the two services
# must point at the same real broker once filled in, but never share a file.
CLOUDAMQP_URL=amqps://user:password@host/vhost
RABBITMQ_EXCHANGE=firewall.commands
RABBITMQ_QUEUE=romi.firewall.commands
RABBITMQ_ROUTING_PREFIX=romi

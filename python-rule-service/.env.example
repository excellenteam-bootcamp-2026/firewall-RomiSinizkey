# Copy to .env and adjust - .env is gitignored, this file is not:
#   cp .env.example .env
#
# Points at the same PostgreSQL instance the Node.js backend uses (see the
# root .env.dev/.env.prod), but is read independently via this service's own
# Pydantic settings object (src/main/config.py) - not via Node's env.ts.

ENV=dev
DATABASE_URI=postgresql://postgres:change_me@localhost:5432/firewall_dev
LOG_LEVEL=INFO

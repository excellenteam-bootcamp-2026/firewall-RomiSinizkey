# Copy to .env and adjust - .env is gitignored, this file is not:
#   cp .env.example .env
#
# Points at the same PostgreSQL instance the Node.js backend uses (see the
# root .env.dev/.env.prod), but is read independently via this service's own
# Pydantic settings object (src/main/config.py) - not via Node's env.ts.
#
# The "+psycopg" driver segment is required (#59): SQLAlchemy's default
# driver for a bare "postgresql://" URL is psycopg2, which this service does
# not install - only psycopg (v3), per Issue #59's own "psycopg[binary]".

ENV=dev
DATABASE_URI=postgresql+psycopg://postgres:change_me@localhost:5432/firewall_dev
LOG_LEVEL=INFO

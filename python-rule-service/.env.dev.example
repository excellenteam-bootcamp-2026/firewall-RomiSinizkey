# Docker development environment template for the Python consumer service.
#
# Copy to .env.dev and adjust if needed — .env.dev is gitignored, this file is not:
#   cp .env.dev.example .env.dev
#
# This file is read by the docker-compose.dev.yml `python-consumer` service's
# `env_file:`. DB host below is "postgres" — the Compose service name, not
# localhost — because inside the Compose network, localhost resolves to the
# python-consumer container itself, not the database container.
#
# For running `python -m src.main` directly on the host (outside Docker, e.g.
# the WSL/venv fallback workflow), use `.env` (see `.env.example`) instead,
# which points DATABASE_URI at localhost.
#
# The "+psycopg" driver segment is required: SQLAlchemy's default driver for a
# bare "postgresql://" URL is psycopg2, which this service does not install -
# only psycopg (v3), per requirements.txt's "psycopg[binary]".
#
# The DB user/password/database name here must match the root .env.dev's
# POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB — both this service and the
# Node backend talk to the same Postgres container.

ENV=dev
DATABASE_URI=postgresql+psycopg://postgres:change_me@postgres:5432/firewall_dev
LOG_LEVEL=INFO

# CloudAMQP-hosted RabbitMQ (Project 7). Placeholder values only - never
# commit a real CloudAMQP URL or credential. Read independently via this
# service's own Pydantic settings object, same as DATABASE_URI above.
CLOUDAMQP_URL=amqps://user:password@host/vhost
RABBITMQ_EXCHANGE=firewall.commands
RABBITMQ_QUEUE=romi.firewall.commands
RABBITMQ_ROUTING_PREFIX=romi

{
  "name": "firewall-orchestrator",
  "version": "1.0.0",
  "description": "NodeJS orchestrator API for managing firewall rules (ips, domains, ports)",
  "main": "dist/main/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/main/server.ts",
    "dev:docker": "ts-node-dev --respawn --poll --transpile-only src/main/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main/server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "node --env-file=.env.test ./node_modules/vitest/vitest.mjs run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:compiled": "node dist/main/migrate.js",
    "db:migrate:dev": "ts-node src/main/migrate.ts",
    "start:container": "npm run db:migrate:compiled && node dist/main/server.js",
    "dev:all": "docker compose --env-file .env.dev -f docker-compose.dev.yml up --build -d",
    "dev:down": "docker compose --env-file .env.dev -f docker-compose.dev.yml down",
    "dev:logs": "docker compose --env-file .env.dev -f docker-compose.dev.yml logs -f",
    "dev:restart": "docker compose --env-file .env.dev -f docker-compose.dev.yml restart",
    "dev:restart:python": "docker compose --env-file .env.dev -f docker-compose.dev.yml restart python-consumer"
  },
  "license": "MIT",
  "dependencies": {
    "amqplib": "^2.0.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.23.0",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.10",
    "supertest": "^7.2.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}

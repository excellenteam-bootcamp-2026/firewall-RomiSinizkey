# Docker production environment template.
#
# Copy to .env.prod and replace every placeholder with a real value before use
# — .env.prod is gitignored, this file is not, and must never contain a real
# password itself:
#   cp .env.prod.example .env.prod
#
# DB_HOST is the PostgreSQL Compose service name, not localhost or
# host.docker.internal — inside a Compose network, localhost resolves to the
# backend container itself, not the database container.
#
# "postgres" is the PostgreSQL Compose service name defined in
# docker-compose.prod.yml — update this file and that Compose file together if
# the service name there is ever changed.

ENV=production
PORT=3000
DB_CONNECTION_INTERVAL=2000

DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_BEFORE_DEPLOY
DB_NAME=firewall_prod

# PostgreSQL container variables, read by the official postgres image itself
# (not by this Node app — env.ts has no POSTGRES_* keys). Kept equal to the
# DB_* values above so the backend and the database container are configured
# from a single source of truth, mapped explicitly in Issue #45's compose file:
#   POSTGRES_USER     = DB_USER
#   POSTGRES_PASSWORD = DB_PASSWORD
#   POSTGRES_DB       = DB_NAME
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_BEFORE_DEPLOY
POSTGRES_DB=firewall_prod
